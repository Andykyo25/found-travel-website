# Railway 後台登入。密碼與 session secret 只放在 Railway Variables，
# 不要寫進 GitHub。
STUDIO_ADMIN_EMAIL=tgfc069@gmail.com
STUDIO_ADMIN_PASSWORD=

# 業務帳號名單（選填）。一行一組「Email:密碼」，密碼至少 8 字元；
# 也可用分號分隔多組。與上方管理員帳號合併使用。
STUDIO_USERS=

# 可選。若未填，系統會安全地從後台帳號名單衍生 session 簽章。
# 建議設定固定值，調整帳號名單時既有登入才不會被登出。
STUDIO_SESSION_SECRET=

# 聯絡表單的 LINE 通知。以下兩種擇一即可，兩種都填會同時送出。
#
# 方式一：LINE Messaging API 直接推播到業務群組。
# LINE_TARGET_ID 是群組 ID（或個人 userId），需先把官方帳號加進該群組。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# 方式二：轉給 Make / Zapier 等自動化服務，再由它發送 LINE。
# 填入該服務提供的 Webhook 網址即可。
CONTACT_WEBHOOK_URL=

# Railway Storage Bucket 連線資訊。可使用 Bucket 的 Auto-inject，
# 或在網站服務的 Variables 中引用 Bucket credentials。
BUCKET_NAME=
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
